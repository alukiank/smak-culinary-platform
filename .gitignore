# ======================================
# Environment files — NEVER commit these
# ======================================
.env
.env.prod
.env.local
.env.*.local

# Cover all subdirectories (api/, client/, etc.)
**/.env
**/.env.prod
**/.env.local
**/.env.*.local

# Allow example/template files
!.env.example
!.env.prod.example
!**/.env.example
!**/.env.prod.example

# ======================================
# IDEs and Editors
# ======================================
.vscode/
**/.vscode/
.idea/
**/.idea/
.DS_Store
Thumbs.db

# ======================================
# Datasets & Large Archives
# ======================================
dataset/
*.zip
email-previews/

